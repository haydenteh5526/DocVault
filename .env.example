# DocVault local configuration. Copy to .env and keep .env out of Git.
# Placeholders only: never commit real keys, passwords or personal email addresses.
#
# Docker Compose sets DATABASE_URL, the S3_* storage settings, REDIS_URL and
# OLLAMA_URL for its own containers, so the values below for those are only
# used when the API runs outside Docker.

# --- Core --------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://docvault:docvault@db:5432/docvault
# Used in verification and password-reset links.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
# Redis cache and background job queue. Blank: in-memory cache and inline processing.
REDIS_URL=

# --- Storage (S3-compatible; RustFS in Docker Compose) -----------------------
S3_ENDPOINT=http://storage:9000
# Address the browser uses for signed file links.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=docvault-local
S3_SECRET_KEY=docvault-local-storage
S3_BUCKET=documents

# --- Auth --------------------------------------------------------------------
# The development value below triggers a startup warning. Set a unique, random
# value of at least 32 characters for any deployed environment.
JWT_SECRET=development-only-secret-replace-before-production-32chars
JWT_EXPIRY_MINUTES=30
# Refresh token lifetime with "Keep me signed in" ticked, and without it.
REFRESH_TOKEN_EXPIRY_DAYS=30
REFRESH_TOKEN_EXPIRY_DAYS_SHORT=1
# How long a verification link works, and how often one account may get a new one.
VERIFICATION_EXPIRY_HOURS=24
VERIFICATION_RESEND_COOLDOWN_S=60

# --- Email -------------------------------------------------------------------
# Local Docker email is captured by Mailpit at http://localhost:8025.
# For real delivery set RESEND_API_KEY (used first; sends from onboarding@resend.dev,
# which delivers only to the Resend account's own address) or an SMTP server.
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@docvault.app

# --- AI ----------------------------------------------------------------------
# None are required (the app falls back to heuristics and retrieved excerpts),
# but generated answers need Groq or Gemini.
#   Answers             : Groq, else Gemini (or a local Ollama model via ANSWER_MODEL)
#   Categorisation      : Groq, else Gemini, else Mistral, else keyword heuristics
#   Summaries           : Mistral
#   Embeddings          : Ollama (local, default in Docker) or Gemini
GROQ_API_KEY=
GEMINI_API_KEY=
# Gemini model for answers and categorisation; thinking is turned off on every call.
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
# Ollama tag for answers. Blank: Groq, Gemini or the no-key reply.
ANSWER_MODEL=
# Ollama tag that picks a tool for chat requests. Blank: the keyword router.
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT_S=20
# Docker Compose sets this for its containers.
OLLAMA_URL=
# Pin the provider so all vectors stay comparable (auto | ollama | gemini).
EMBEDDING_PROVIDER=auto
# OCR engine: tesseract (local, default) | mistral | textract (AWS, pay per page)
OCR_BACKEND=tesseract
# Only used by the textract OCR backend.
AWS_REGION=eu-west-1

# --- Observability (optional) ------------------------------------------------
# Set both keys to trace answers in Langfuse. Blank turns tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Google sign-in (optional) -----------------------------------------------
# Enables "Continue with Google". The authorised redirect URI in the Google
# console must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
