# Database
DATABASE_URL=postgresql+asyncpg://docvault:docvault@db:5432/docvault

# S3-compatible object storage (RustFS in Docker Compose)
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=docvault-local
S3_SECRET_KEY=docvault-local-storage
S3_BUCKET=documents

# Auth — this development-only value triggers a startup warning. Set a unique,
# random value of at least 32 characters for any deployed environment.
JWT_SECRET=development-only-secret-replace-before-production-32chars

# AI providers. None are strictly required (the app degrades to heuristics and
# zero-vectors), but Q&A needs at least one of Groq or Gemini.
#
#   Q&A / RAG answers   : Groq, else Gemini
#   Categorisation      : Groq, else Gemini, else Mistral, else keyword heuristics
#   Summaries           : Mistral
#   Embeddings          : Ollama (local, default in Docker) or Gemini
#
# Groq is the recommended free option for Q&A (Llama 3.3 70B).
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# OCR engine: tesseract (default, local) | mistral | textract (AWS, pay-per-page)
OCR_BACKEND=tesseract

# Local embedding model — docker-compose sets this automatically.
OLLAMA_URL=

# Embeddings: pin the provider so all vectors stay comparable (auto | ollama | gemini)
# Changing providers after documents are embedded makes similarity meaningless.
EMBEDDING_PROVIDER=auto

# Redis — cache + background job queue. Blank falls back to in-memory cache and
# inline (synchronous) document processing.
REDIS_URL=

# Local Docker email is captured by Mailpit at http://localhost:8025.
# For real delivery, configure Resend (takes precedence) or an SMTP server.
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@docvault.app

# LLM observability (optional) — set both keys to enable Langfuse tracing of RAG answers.
# Leave blank to disable (no-op). Get keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Google OAuth (optional — enables "Continue with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=["http://localhost:3000"]
